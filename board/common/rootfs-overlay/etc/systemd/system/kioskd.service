[Unit]
Description=Kiosk app launcher
After=kiosk-config.service data.mount kioskd-dirs.service
Wants=data.mount
Requires=kioskd-dirs.service

[Service]
EnvironmentFile=-/run/kiosk/kioskd.env
ExecStart=/usr/sbin/kioskd daemon
Restart=always
RestartSec=2
ProtectSystem=strict
ReadWritePaths=/data/store /run
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
