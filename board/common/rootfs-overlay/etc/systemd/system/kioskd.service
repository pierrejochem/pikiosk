[Unit]
Description=Kiosk app launcher
After=kiosk-config.service data.mount kioskd-dirs.service
Wants=data.mount
Requires=kioskd-dirs.service

[Service]
EnvironmentFile=-/run/kiosk/kioskd.env
ExecStart=/usr/sbin/kioskd daemon
Restart=always
RestartSec=2
# /run/kioskd holds the socket; it stays across restarts, so apps that have it hidden keep it hidden
RuntimeDirectory=kioskd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
OOMScoreAdjust=-900
ProtectSystem=strict
ReadWritePaths=/data/store /run
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
