[Unit]
Description=Kiosk app %i
# the app takes the display from kiosk-ui, and kiosk-ui takes it back
# when the app ends, however it ends
Conflicts=kiosk.service
After=kiosk.service kiosk-config.service data.mount
OnSuccess=kiosk-handback.service
OnFailure=kiosk-handback.service
# crash loop protection: after 5 failures in 2 minutes give up and show kiosk-ui
StartLimitIntervalSec=120
StartLimitBurst=5
StartLimitAction=none

[Service]
User=kiosk
Group=kiosk
SupplementaryGroups=video render input
EnvironmentFile=-/run/kiosk/app.env
Environment=HOME=/data/app XDG_RUNTIME_DIR=/run/kiosk-app KIOSK_DATA=/data/app
RuntimeDirectory=kiosk-app
RuntimeDirectoryMode=0700
WorkingDirectory=/data/app
# kioskd writes a drop-in that sets the real program, arguments and permissions
ExecStart=/bin/false
Restart=on-failure
RestartSec=2
# a runaway app must not starve kiosk-ui and kioskd: fewer tasks, less CPU, first to be OOM-killed
TasksMax=128
CPUWeight=50
OOMScoreAdjust=500

# the app sees only its own files (read-only) and its own state, at the
# /data/app path kiosk apps use
TemporaryFileSystem=/data:ro
# an app can neither talk to kioskd (the PIN checks and installs) nor read kiosk.conf.
# The socket sits in a directory: hiding a single socket file stops working the
# moment kioskd restarts and replaces it
InaccessiblePaths=/boot /run/kioskd
BindReadOnlyPaths=/data/store/apps/%i
BindPaths=/data/store/data/%i:/data/app
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
